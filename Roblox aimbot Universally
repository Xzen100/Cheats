	btn.Font = Enum.Font.SourceSans
	btn.TextSize = 16
	btn.Parent = sidebar
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim2.new(0, 6)
	corner.Parent = btn
	
	btn.MouseButton1Click:Connect(function()
		selectTab(text)
	end)
end

