local function GetChar(player)
    return player.Character or workspace:FindFirstChild(player.Name)
end

local function GetTargetPart(char)
    if not char then return nil end
    return char:FindFirstChild("Head") 
        or char:FindFirstChild("HumanoidRootPart") 
        or char:FindFirstChild("Torso") 
        or char:FindFirstChild("Hitbox")
        or char:FindFirstChildWhichIsA("BasePart")
end

local function IsVisible(part, char)
    local LocalChar = GetChar(LocalPlayer)
    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude
    RayParams.FilterDescendantsInstances = {LocalChar, Camera, char}
    RayParams.IgnoreWater = true
    return workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position), RayParams) == nil
end

local function GetTarget()
    local Closest, Shortest = nil, Settings.Aimbot.Radius
    local viewport = Camera.ViewportSize
    if viewport.X <= 0 or viewport.Y <= 0 then return nil end
    local Center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not Settings.Aimbot.TeamCheck or (player.Team ~= LocalPlayer.Team) then
                local char = GetChar(player)
                local part = GetTargetPart(char)
                if part then
                    if not Settings.Aimbot.WallCheck or IsVisible(part, char) then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - Center).Magnitude
                            if dist < Shortest then
                                Shortest = dist
                                Closest = part
                            end
                        end
                    end
                end
            end
        end
    end
    return Closest
end

-- ==========================================
-- 4. ESP RENDER PIPELINE
-- ==========================================
local ESPCache = {}

local function CreateDrawings(player)
    if ESPCache[player] then return end

    local Box = Instance.new("Frame", SafeGui)
    Box.BackgroundTransparency = 1
    Box.Visible = false
    local Stroke = Instance.new("UIStroke", Box)
    Stroke.Color = Color3.fromRGB(255, 50, 50)
    Stroke.Thickness = 1

    local Tracer = Instance.new("Frame", SafeGui)
    Tracer.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    Tracer.BorderSizePixel = 0
    Tracer.AnchorPoint = Vector2.new(0.5, 0.5)
    Tracer.Visible = false

    ESPCache[player] = { Box = Box, Tracer = Tracer }
end

for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then CreateDrawings(p) end end
Players.PlayerAdded:Connect(CreateDrawings)
Players.PlayerRemoving:Connect(function(p)
    if ESPCache[p] then
        pcall(function() ESPCache[p].Box:Destroy() end)
        pcall(function() ESPCache[p].Tracer:Destroy() end)
        ESPCache[p] = nil
    end
end)

-- Main Loop
pcall(function() RunService:UnbindFromRenderStep("UniversalScriptLoop") end)
RunService:BindToRenderStep("UniversalScriptLoop", Enum.RenderPriority.Camera.Value + 1, function()
    local viewport = Camera.ViewportSize
    if viewport.X <= 0 or viewport.Y <= 0 then return end
    
    local Center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    
    FOVCircle.Position = UDim2.new(0, Center.X, 0, Center.Y)
    FOVCircle.Size = UDim2.new(0, Settings.Aimbot.Radius * 2, 0, Settings.Aimbot.Radius * 2)

    -- Aimlock
    if Settings.Aimbot.Enabled then
        local target = GetTarget()
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        end
    end

    -- ESP Rendering
    for player, drawings in pairs(ESPCache) do
        local Char = GetChar(player)
        local Valid = Char and Char.Parent and (not Settings.ESP.TeamCheck or player.Team ~= LocalPlayer.Team)
        
        if Valid then
            local part = GetTargetPart(Char)
            if part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local size = Char:ExtentsSize()
                    local topPos = Camera:WorldToViewportPoint((part.CFrame * CFrame.new(0, size.Y / 2, 0)).Position)
                    local botPos = Camera:WorldToViewportPoint((part.CFrame * CFrame.new(0, -size.Y / 2, 0)).Position)

                    local h = math.abs(topPos.Y - botPos.Y)
                    local w = h * 0.6

                    if Settings.ESP.Boxes then
                        drawings.Box.Size = UDim2.new(0, w, 0, h)
                        drawings.Box.Position = UDim2.new(0, pos.X - w / 2, 0, pos.Y - h / 2)
                        drawings.Box.Visible = true
                    else drawings.Box.Visible = false end

                    if Settings.ESP.Tracers then
                        local start = Vector2.new(Center.X, viewport.Y)
                        local targetVec = Vector2.new(pos.X, pos.Y)
                        local dist = (targetVec - start).Magnitude
                        
                        if dist > 1 then
                            drawings.Tracer.Size = UDim2.new(0, dist, 0, 1)
                            drawings.Tracer.Position = UDim2.new(0, (start.X + targetVec.X) / 2, 0, (start.Y + targetVec.Y) / 2)
                            drawings.Tracer.Rotation = math.deg(math.atan2(targetVec.Y - start.Y, targetVec.X - start.X))
                            drawings.Tracer.Visible = true
                        else drawings.Tracer.Visible = false end
                    else drawings.Tracer.Visible = false end
                else drawings.Box.Visible = false drawings.Tracer.Visible = false end
            else drawings.Box.Visible = false drawings.Tracer.Visible = false end
        else drawings.Box.Visible = false drawings.Tracer.Visible = false end
    end
end)
