local function MakeToggle(text, default, callback)
    local Btn = Instance.new("TextButton", Container)
    Btn.Size = UDim2.new(1, 0, 0, 32)
    Btn.BackgroundColor3 = default and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(30, 30, 35)
    Btn.Text = text .. " [" .. (default and "ON" or "OFF") .. "]"
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextSize = 11

    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 5)

    local state = default
    Btn.MouseButton1Click:Connect(function()
        state = not state
        Btn.BackgroundColor3 = state and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(30, 30, 35)
        Btn.Text = text .. " [" .. (state and "ON" or "OFF") .. "]"
        callback(state)
    end)
end

