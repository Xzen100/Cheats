    Tracer.BorderSizePixel = 0
    Tracer.AnchorPoint = Vector2.new(0.5, 0.5)
    Tracer.Visible = false

    ESPCache[player] = { Box = Box, Tracer = Tracer }
end

for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then CreateESP(p) end end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(function(p)
    if ESPCache[p] then
        pcall(function() ESPCache[p].Box:Destroy() end)
        pcall(function() ESPCache[p].Tracer:Destroy() end)
        ESPCache[p] = nil
    end
end)

-- Main Loop
local hue = 0
RunService:BindToRenderStep("MasterRenderLoop", Enum.RenderPriority.Camera.Value + 1, function()
    local viewport = Camera.ViewportSize
    if viewport.X <= 0 or viewport.Y <= 0 then return end
    
    local Center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    
    -- Rainbow Dynamic FOV
    hue = (hue + 0.005) % 1
    if Settings.Visuals.RainbowFOV then
        CircleStroke.Color = Color3.fromHSV(hue, 0.8, 1)
    else
        CircleStroke.Color = Color3.fromRGB(0, 255, 170)
    end

    FOVCircle.Position = UDim2.new(0, Center.X, 0, Center.Y)
    FOVCircle.Size = UDim2.new(0, Settings.Aimbot.Radius * 2, 0, Settings.Aimbot.Radius * 2)

    -- Smart Aimlock
    if Settings.Aimbot.Enabled then
        local target = GetClosestTarget()
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        end
    end

    -- Universal ESP Render
    for player, drawings in pairs(ESPCache) do
        local Char = GetCharacter(player)
        local Valid = Char and Char.Parent and (not Settings.ESP.TeamCheck or player.Team ~= LocalPlayer.Team)
        
        if Valid then
            local part = GetTargetPart(Char)
            if part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local size = Char:ExtentsSize()
                    local topPos = Camera:WorldToViewportPoint((part.CFrame * CFrame.new(0, size.Y / 2, 0)).Position)
                    local botPos = Camera:WorldToViewportPoint((part.CFrame * CFrame.new(0, -size.Y / 2, 0)).Position)

                    local h = math.abs(topPos.Y - botPos.Y)
                    local w = h * 0.65

                    if Settings.ESP.Boxes then
                        drawings.Box.Size = UDim2.new(0, w, 0, h)
                        drawings.Box.Position = UDim2.new(0, pos.X - w / 2, 0, pos.Y - h / 2)
                        drawings.Box.Visible = true
                    else drawings.Box.Visible = false end

                    if Settings.ESP.Tracers then
                        local start = Vector2.new(Center.X, viewport.Y)
                        local targetVec = Vector2.new(pos.X, pos.Y)
                        local dist = (targetVec - start).Magnitude
                        
                        if dist > 1 then
                            drawings.Tracer.Size = UDim2.new(0, dist, 0, 1)
                            drawings.Tracer.Position = UDim2.new(0, (start.X + targetVec.X) / 2, 0, (start.Y + targetVec.Y) / 2)
                            drawings.Tracer.Rotation = math.deg(math.atan2(targetVec.Y - start.Y, targetVec.X - start.X))
                            drawings.Tracer.Visible = true
                        else drawings.Tracer.Visible = false end
                    else drawings.Tracer.Visible = false end
                else drawings.Box.Visible = false drawings.Tracer.Visible = false end
            else drawings.Box.Visible = false drawings.Tracer.Visible = false end
        else drawings.Box.Visible = false drawings.Tracer.Visible = false end
    end
end)
