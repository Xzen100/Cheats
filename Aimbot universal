-- // Raycast Line-of-Sight Check
local function IsVisible(part)
    local Character = LocalPlayer.Character
    if not Character then return false end

    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude
    RayParams.FilterDescendantsInstances = {Character, Camera}
    RayParams.IgnoreWater = true

    local RayResult = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position), RayParams)
    return RayResult == nil or RayResult.Instance:IsDescendantOf(part.Parent)
end

-- // Team Check Helper
local function IsTeammate(player)
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return true
    end
    return false
end

-- // Target Acquisition
local Target = nil

local function GetClosestPlayerToCenter()
    local Closest = nil
    local ShortestDistance = Settings.FOV.Radius
    local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(Settings.Aimlock.LockPart) then
            
            -- Apply Aimbot Team Check
            if not Settings.Aimlock.TeamCheck or not IsTeammate(player) then
                local Part = player.Character[Settings.Aimlock.LockPart]
                
                -- Apply Aimbot Wall Check
                if not Settings.Aimlock.WallCheck or IsVisible(Part) then
                    local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Part.Position)

                    if OnScreen then
                        local ScreenPosVector = Vector2.new(ScreenPos.X, ScreenPos.Y)
                        local Distance = (ScreenPosVector - ScreenCenter).Magnitude

                        if Distance < ShortestDistance then
                            ShortestDistance = Distance
                            Closest = Part
                        end
                    end
                end
            end
        end
    end
    return Closest
end

-- // ESP Cache
local ESPCache = {}

local function CreateESP(player)
    local BoxFrame = Instance.new("Frame", ScreenGui)
    BoxFrame.BackgroundTransparency = 1
    BoxFrame.Visible = false

    local BoxStroke = Instance.new("UIStroke", BoxFrame)
    BoxStroke.Color = Color3.fromRGB(255, 255, 255)
    BoxStroke.Thickness = 1.5

    local TracerFrame = Instance.new("Frame", ScreenGui)
    TracerFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    TracerFrame.BorderSizePixel = 0
    TracerFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    TracerFrame.Visible = false

    ESPCache[player] = { Box = BoxFrame, Tracer = TracerFrame }
end

local function RemoveESP(player)
    if ESPCache[player] then
        ESPCache[player].Box:Destroy()
        ESPCache[player].Tracer:Destroy()
        ESPCache[player] = nil
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then CreateESP(player) end
end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

-- // Render Loop
RunService.RenderStepped:Connect(function()
    local CenterX = Camera.ViewportSize.X / 2
    local CenterY = Camera.ViewportSize.Y / 2

    FOVFrame.Size = UDim2.new(0, Settings.FOV.Radius * 2, 0, Settings.FOV.Radius * 2)
    FOVFrame.Visible = Settings.FOV.Enabled

    -- Hard Lock Aimlock Loop
    if Settings.Aimlock.Enabled then
        Target = GetClosestPlayerToCenter()
        if Target and Target.Parent and Target.Parent:FindFirstChild("Humanoid") and Target.Parent.Humanoid.Health > 0 then
            local TargetPos = Target.Position + Vector3.new(0, Settings.Aimlock.YOffset, 0)
            local CameraPos = Camera.CFrame.Position
            
            Camera.CFrame = CFrame.new(CameraPos, TargetPos)
        end
    end

    -- ESP Rendering Loop
    for player, drawings in pairs(ESPCache) do
        local ShouldShowESP = player.Character 
            and player.Character:FindFirstChild("HumanoidRootPart") 
            and player.Character:FindFirstChild("Humanoid") 
            and player.Character.Humanoid.Health > 0
            and (not Settings.ESP.TeamCheck or not IsTeammate(player))

        if ShouldShowESP then
            local Root = player.Character.HumanoidRootPart
            local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)

            if OnScreen then
                local Head = player.Character:FindFirstChild("Head")
                local HeadPos = Head and Head.Position or (Root.Position + Vector3.new(0, 3, 0))
                local HeadScreen = Camera:WorldToViewportPoint(HeadPos + Vector3.new(0, 0.5, 0))
                local LegScreen = Camera:WorldToViewportPoint(Root.Position - Vector3.new(0, 3, 0))

                local Height = math.abs(HeadScreen.Y - LegScreen.Y)
                local Width = Height * 0.65

                if Settings.ESP.Boxes then
                    drawings.Box.Size = UDim2.new(0, Width, 0, Height)
                    drawings.Box.Position = UDim2.new(0, Pos.X - Width / 2, 0, Pos.Y - Height / 2)
                    drawings.Box.Visible = true
                else
                    drawings.Box.Visible = false
                end

                if Settings.ESP.Tracers then
                    local StartPos = Vector2.new(CenterX, Camera.ViewportSize.Y)
                    local EndPos = Vector2.new(Pos.X, Pos.Y)
                    local Distance = (EndPos - StartPos).Magnitude
                    local Angle = math.atan2(EndPos.Y - StartPos.Y, EndPos.X - StartPos.X)

                    drawings.Tracer.Size = UDim2.new(0, Distance, 0, 1.5)
                    drawings.Tracer.Position = UDim2.new(0, (StartPos.X + EndPos.X) / 2, 0, (StartPos.Y + EndPos.Y) / 2)
                    drawings.Tracer.Rotation = math.deg(Angle)
                    drawings.Tracer.Visible = true
                else
                    drawings.Tracer.Visible = false
                end
            else
                drawings.Box.Visible = false
                drawings.Tracer.Visible = false
            end
        else
            drawings.Box.Visible = false
            drawings.Tracer.Visible = false
        end
    end
end)

