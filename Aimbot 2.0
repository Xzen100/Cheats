-- ==========================================
-- 3. ADVANCED CUSTOM CHARACTER DETECTOR
-- ==========================================
local FOVCircle = Instance.new("Frame", ScreenGui)
FOVCircle.AnchorPoint = Vector2.new(0.5, 0.5)
FOVCircle.BackgroundTransparency = 1
FOVCircle.Visible = false
Instance.new("UICorner", FOVCircle).CornerRadius = UDim.new(1, 0)

local CircleStroke = Instance.new("UIStroke", FOVCircle)
CircleStroke.Color = Color3.fromRGB(255, 255, 255)
CircleStroke.Thickness = 1

local function IsTeammate(player)
    return player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team
end

-- Searches for valid aim targets inside custom rigs
local function GetTargetPart(character)
    if not character then return nil end
    
    -- Check common custom FPS game part names
    local Target = character:FindFirstChild("Head") 
        or character:FindFirstChild("Hitbox") 
        or character:FindFirstChild("HumanoidRootPart") 
        or character:FindFirstChild("Torso") 
        or character:FindFirstChild("UpperTorso")
        
    if Target and Target:IsA("BasePart") then return Target end

    -- Fallback: Scan model for the primary BasePart
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BasePart") and not child.Name:lower():find("gun") and not child.Name:lower():find("weapon") then
            return child
        end
    end
    return nil
end

local function IsVisible(part, character)
    local LocalChar = LocalPlayer.Character
    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude
    RayParams.FilterDescendantsInstances = {LocalChar, Camera, character}
    RayParams.IgnoreWater = true
    
    local RayResult = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position), RayParams)
    return RayResult == nil
end

local function GetClosestTarget()
    local Closest, Shortest = nil, Settings.FOV.Radius
    local viewport = Camera.ViewportSize
    if viewport.X <= 0 or viewport.Y <= 0 then return nil end
    local ScreenCenter = Vector2.new(viewport.X / 2, viewport.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char.Parent then
                if not Settings.Aimlock.TeamCheck or not IsTeammate(player) then
                    local Part = GetTargetPart(char)
                    if Part then
                        if not Settings.Aimlock.WallCheck or IsVisible(Part, char) then
                            local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Part.Position)
                            if OnScreen then
                                local Dist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - ScreenCenter).Magnitude
                                if Dist < Shortest then
                                    Shortest = Dist
                                    Closest = Part
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return Closest
end

local ESPCache = {}
local function CreateESP(player)
    if ESPCache[player] then
        pcall(function() ESPCache[player].Box:Destroy() end)
        pcall(function() ESPCache[player].Tracer:Destroy() end)
    end

    local Box = Instance.new("Frame", ScreenGui)
    Box.BackgroundTransparency = 1
    Box.Visible = false
    local Stroke = Instance.new("UIStroke", Box)
    Stroke.Color = Color3.fromRGB(255, 255, 255)
    Stroke.Thickness = 1

    local Tracer = Instance.new("Frame", ScreenGui)
    Tracer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Tracer.BorderSizePixel = 0
    Tracer.AnchorPoint = Vector2.new(0.5, 0.5)
    Tracer.Visible = false

    ESPCache[player] = { Box = Box, Tracer = Tracer }
end

for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then CreateESP(p) end end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(function(p) 
    if ESPCache[p] then 
        pcall(function() ESPCache[p].Box:Destroy() end) 
        pcall(function() ESPCache[p].Tracer:Destroy() end) 
        ESPCache[p] = nil 
    end 
end)

-- Render Loop
RunService:BindToRenderStep("AimbotESP", Enum.RenderPriority.Camera.Value + 1, function()
    local viewport = Camera.ViewportSize
    if viewport.X <= 0 or viewport.Y <= 0 then return end
    
    local ScreenCenter = Vector2.new(viewport.X / 2, viewport.Y / 2)
    
    FOVCircle.Position = UDim2.new(0, ScreenCenter.X, 0, ScreenCenter.Y)
    FOVCircle.Size = UDim2.new(0, Settings.FOV.Radius * 2, 0, Settings.FOV.Radius * 2)
    FOVCircle.Visible = Settings.FOV.Enabled

    -- Instant Lock
    if Settings.Aimlock.Enabled then
        local target = GetClosestTarget()
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        end
    end

    -- Dynamic Custom Rig ESP
    for player, drawings in pairs(ESPCache) do
        local Char = player.Character
        local Valid = Char and Char.Parent and (not Settings.ESP.TeamCheck or not IsTeammate(player))
        
        if Valid then
            -- Fetch actual model 3D space bounding box
            local success, cf, size = pcall(function() return Char:GetBoundingBox() end)
            
            if success and cf then
                local Pos, OnScreen = Camera:WorldToViewportPoint(cf.Position)

                if OnScreen then
                    local TopPos = Camera:WorldToViewportPoint((cf + Vector3.new(0, size.Y / 2, 0)).Position)
                    local BottomPos = Camera:WorldToViewportPoint((cf - Vector3.new(0, size.Y / 2, 0)).Position)

                    local Height = math.abs(TopPos.Y - BottomPos.Y)
                    local Width = Height * 0.65

                    if Settings.ESP.Boxes then
                        drawings.Box.Size = UDim2.new(0, Width, 0, Height)
                        drawings.Box.Position = UDim2.new(0, Pos.X - Width / 2, 0, Pos.Y - Height / 2)
                        drawings.Box.Visible = true
                    else drawings.Box.Visible = false end

                    if Settings.ESP.Tracers then
                        local Start = Vector2.new(ScreenCenter.X, viewport.Y)
                        local End = Vector2.new(Pos.X, BottomPos.Y)
                        local dist = (End - Start).Magnitude
                        if dist > 0 then
                            drawings.Tracer.Size = UDim2.new(0, dist, 0, 1)
                            drawings.Tracer.Position = UDim2.new(0, (Start.X + End.X) / 2, 0, (Start.Y + End.Y) / 2)
                            drawings.Tracer.Rotation = math.deg(math.atan2(End.Y - Start.Y, End.X - Start.X))
                            drawings.Tracer.Visible = true
                        else drawings.Tracer.Visible = false end
                    else drawings.Tracer.Visible = false end
                else drawings.Box.Visible = false drawings.Tracer.Visible = false end
            else drawings.Box.Visible = false drawings.Tracer.Visible = false end
        else drawings.Box.Visible = false drawings.Tracer.Visible = false end
    end
end)
